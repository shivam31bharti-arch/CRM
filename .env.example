# Application environment variables.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
NEXTAUTH_URL="http://localhost:3000"

# Required. Generate with: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME_GENERATE_BASE64_32"
NEXTAUTH_SECRET="CHANGE_ME_GENERATE_BASE64_32"

# Required for OAuth token encryption. Generate with: openssl rand -hex 32
ENCRYPTION_KEY="CHANGE_ME_GENERATE_HEX_32_BYTES"

# Required for the cron scheduler. Generate with: openssl rand -base64 32
CRON_SECRET="CHANGE_ME_GENERATE_BASE64_32"

# Supabase Storage for private social-media uploads.
# Create this bucket in Supabase Storage and keep its "Public bucket" setting disabled.
# The service-role key is server-only: never prefix it with NEXT_PUBLIC_ or expose it to clients.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="CHANGE_ME_SERVER_ONLY"
SUPABASE_STORAGE_BUCKET="social-media"

# Twitter / X OAuth 2.0.
# Create at: https://developer.twitter.com/en/portal/dashboard
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""

# LinkedIn OAuth 2.0.
# Create at: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Facebook + Instagram (Meta Graph API).
# Create at: https://developers.facebook.com/apps
# Set this to the Graph API version enabled for your Meta app (for example, vNN.N).
META_GRAPH_API_VERSION=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# Google Workspace OAuth (one account per CRM user).
# Enable the Gmail API and Google Calendar API in Google Cloud. The redirect URI must match exactly.
# Approved scopes: openid, email, gmail.metadata, calendar.events.owned.readonly.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/integrations/google/callback"
